[Unit]
Description=Bot de Cartões e Chutes - Analisador Pré-Jogo
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bot-cartoes
ExecStart=/home/ubuntu/bot-cartoes/venv/bin/python src/monitor_copa_pre.py --loop
Restart=always
RestartSec=30
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=bot-pre

[Install]
WantedBy=multi-user.target
