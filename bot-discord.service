[Unit]
Description=Bot do Discord - Consultas Interativas
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bot-cartoes
ExecStart=/home/ubuntu/bot-cartoes/venv/bin/python src/bot_discord.py
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=bot-discord

[Install]
WantedBy=multi-user.target
