# ── FONTE DE FALTAS ───────────────────────────────────────────────────────────
# "hibrido" -> Copa via API-Football + clubes via ESPN (recomendado)
# "espn"    -> só clubes (Premier, LaLiga, Champions...), SEM LIMITE
FONTE_FALTAS=hibrido

# ── API-FOOTBALL — grátis 100 req/dia ─────────────────────────────────────────
# Crie conta em https://www.api-football.com/ → copie a API key
API_FOOTBALL_KEY=cole_sua_chave_aqui

# ── BSD (Bzzoiro Sports Data) — GRATUITO, SEM LIMITES, ODDS REAIS ────────────
# A MELHOR fonte gratuita! 17+ casas de apostas, stats por jogador, ML.
# Registro: https://sports.bzzoiro.com/register/  → API Key
BSD_TOKEN=cole_sua_chave_bsd_aqui

# ── WHATSAPP (CallMeBot) — grátis ─────────────────────────────────────────────
# Setup: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=5511999999999
CALLMEBOT_APIKEY=cole_sua_apikey_aqui

# ── BET365 (opcional) — odds de jogadores na Copa ────────────────────────────
# Requer cookie de sessão logada na bet365. Se não configurar, o sistema
# usa fair odds do modelo como referência.
BET365_COOKIE=
BET365_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ── REGRAS DO SINAL ────────────────────────────────────────────────────────────
PROB_MINIMA=0.40        # prob mínima de cartão pra avisar
PROB_MINIMA_CHUTES=0.50 # prob mínima de chutes a gol pra avisar
MIN_FALTAS=2            # só olha quem já fez X faltas
META_CHUTES=1           # mercado: N+ chutes a gol (1 = mais fácil)
INTERVALO_SEG=60        # com jogo ao vivo: varre a cada N segundos
INTERVALO_OCIOSO=3600   # sem jogo: espera 1h
ARBITRO_MEDIA_PADRAO=3.8

# ── MONITORES DA COPA ──────────────────────────────────────────────────────────
# Use os monitores STANDALONE:
#
#   AO VIVO (dispara sinais durante os jogos + alimenta cache):
#     python src/monitor_copa.py
#
#   PRÉ-JOGO (odds reais + EV antes dos jogos):
#     python src/monitor_copa_pre.py
#     python src/monitor_copa_pre.py --loop
#     python src/monitor_copa_pre.py --liga "Brasileirão"
#
# ESPN e BSD são gratuitos e ilimitados.
# Quando a Copa acabar, pare os processos da Copa.
#
# ── BOT DO DISCORD (comandos interativos) ────────────────────────────────────
# Crie um aplicativo em https://discord.com/developers/applications
# Vá em Bot → Token → copie o token. Adicione o bot ao seu servidor.
# Habilite: SERVER MEMBERS INTENT + MESSAGE CONTENT INTENT
# Uso: python src/bot_discord.py
DISCORD_BOT_TOKEN=cole_o_token_do_bot_aqui
