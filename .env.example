# ── FONTE DE FALTAS: "apifootball" (estável) ou "sofascore" (granular) ─────────
FONTE_FALTAS=apifootball

# ── API-FOOTBALL (recomendado) — grátis 100 req/dia ───────────────────────────
# Crie conta em https://www.api-football.com/  → copie a API key
API_FOOTBALL_KEY=cole_sua_chave_aqui

# ── WHATSAPP (CallMeBot) — grátis ─────────────────────────────────────────────
# Setup: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=5511999999999
CALLMEBOT_APIKEY=cole_sua_apikey_aqui

# ── BET365 (opcional) — odds ao vivo, requer cookie da sua conta logada ───────
BET365_COOKIE=

# ── REGRAS DO SINAL ────────────────────────────────────────────────────────────
PROB_MINIMA=0.40        # prob mínima de cartão pra avisar
MIN_FALTAS=2            # só olha quem já fez X faltas
INTERVALO_SEG=60        # varre os jogos a cada N segundos
ARBITRO_MEDIA_PADRAO=3.8
